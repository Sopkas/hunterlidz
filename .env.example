# Hunter settings. Copy to .env and fill in. .env is in .gitignore — never commit it.
# Every developer uses their own keys.

# Your Hunter user name (created by `hunter init` / `hunter users add`). Required.
HUNTER_ACTOR=
# SQLite database file (default hunter.db)
HUNTER_DB=
# Business time zone as a fixed UTC offset (default +03:00)
HUNTER_BUSINESS_UTC_OFFSET=
# Default currency for budgets without a currency mark (default RUB)
HUNTER_DEFAULT_CURRENCY=
# Team documents (01-…13-*.md) used as AI context; outside the repository (default documents)
HUNTER_KNOWLEDGE_DIR=

# --- AI research (doc 12). Required before any model call; missing values exit with code 2.
# Model provider: Anthropic Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=
# Model (default claude-haiku-4-5)
HUNTER_CLAUDE_MODEL=
# Tariff per 1M tokens in COST_CURRENCY (claude-haiku-4-5: 1 and 5 USD). Unknown tariff = no run.
HUNTER_LLM_PRICE_INPUT_PER_MTOK=
HUNTER_LLM_PRICE_OUTPUT_PER_MTOK=
COST_CURRENCY=
# Mandatory positive money caps per research run and per day
RUN_COST_CAP=
DAILY_COST_CAP=
# Optional limits (defaults from doc 12)
RESEARCH_MAX_LLM_CALLS=
RESEARCH_MAX_INPUT_TOKENS=
RESEARCH_MAX_OUTPUT_TOKENS=
RESEARCH_MAX_ACTIVE_SECONDS=
