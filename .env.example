# Hunter settings. Copy to .env and fill in. .env is in .gitignore — never commit it.
# Every developer uses their own database and keys.

# PostgreSQL connection URL. Required. Local database from `docker compose up -d --wait`:
# postgresql://hunter:hunter@localhost:5432/hunter
HUNTER_DATABASE_URL=
# Business time zone as a fixed UTC offset (default +03:00)
HUNTER_BUSINESS_UTC_OFFSET=
# Default currency for budgets without a currency mark (default RUB)
HUNTER_DEFAULT_CURRENCY=

# Model provider (ADR-0002). Empty model: no model is called.
# Research (owner, 19.10): polza.ai, deepseek/deepseek-v4.1-flash-1017; fallback openai/gpt-6-luna.
# On OpenRouter only open-source models with ":free"; no Gemini.
HUNTER_LLM_MODEL=
# Default https://openrouter.ai/api/v1; polza.ai: https://api.polza.ai/api/v1;
# a local server: http://127.0.0.1:11434/v1
HUNTER_LLM_BASE_URL=
# json_schema (default) or json_object for models without strict schemas (Claude)
HUNTER_LLM_STRUCTURED=
# Prices per million tokens, required for a paid model (ADR-0002, point 5), polza.ai 19.10:
# deepseek-v4.1-flash-1017 9.36 / 28.07 RUB, gpt-6-luna 5.97 / 29.84 RUB
HUNTER_LLM_PRICE_INPUT_PER_M=
HUNTER_LLM_PRICE_OUTPUT_PER_M=
# The key is NOT set here: export HUNTER_LLM_API_KEY in the shell (ADR-0002, point 2).
