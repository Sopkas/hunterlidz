# Ключи AI-моделей для Hunter. Этот файл не коммитить (он в .gitignore).
# Какую модель использовать: gemini или claude. Пусто — gemini, если есть его ключ.
HUNTER_LLM=

# Google AI Studio (бесплатно): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-flash-lite-latest)
HUNTER_GEMINI_MODEL=

# Anthropic Claude (платно): https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
# Модель Claude (по умолчанию claude-haiku-4-5)
HUNTER_MODEL=